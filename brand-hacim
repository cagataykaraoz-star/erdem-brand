function fmtNum(v){ return Math.round(v).toLocaleString('tr-TR'); }
function fmtPct(v, withSign=true){
  if(v===null||v===undefined) return {txt:"N/A", cls:"neu"};
  const cls = v>0.05 ? "pos" : (v<-0.05 ? "neg" : "neu");
  const sign = v>0 ? "+" : "";
  return {txt:(withSign?sign:"")+v.toFixed(1)+"%", cls};
